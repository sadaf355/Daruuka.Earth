# Root-level overrides for `docker-compose up`.
# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# Compose reads this file automatically for ${VAR} substitution.

# Required for the live map inside Docker.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
VITE_API_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-secret-change-me

# GenAI: leave as "fallback" to run with no API key at all.
LLM_PROVIDER=fallback
GEMINI_API_KEY=
GROQ_API_KEY=

# Autonomous agent sweep interval (seconds). Lower it to watch the agent work in a demo.
AGENT_ENABLED=true
AGENT_INTERVAL_SECONDS=120
