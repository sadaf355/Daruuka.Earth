# --- Database ---
DATABASE_URL=postgresql+psycopg2://darukaa:darukaa@localhost:5432/darukaa

# --- Auth ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (JSON array; must include the deployed frontend origin) ---
CORS_ORIGINS=["http://localhost:5173"]

# --- GenAI ---
# "fallback" needs no API key and answers purely from your own project data.
# Set to "gemini" or "groq" plus the matching key to use a hosted model.
LLM_PROVIDER=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Autonomous monitoring agent ---
AGENT_ENABLED=true
AGENT_INTERVAL_SECONDS=900
